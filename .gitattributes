# Normalize line endings to LF in the repo and the working tree (all platforms).
* text=auto eol=lf

# Treat these as binary (no EOL conversion, no diff).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.icns binary

# Generated files: collapse diffs and exclude from language stats.
pnpm-lock.yaml linguist-generated=true -diff
CHANGELOG.md linguist-generated=true
