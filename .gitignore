# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
out/
*.tsbuildinfo

# The composite action ships a committed, bundled dist (standard for Actions).
!packages/action/dist/
!packages/action/dist/**

# Test / coverage
coverage/
.vitest/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example
*.pem
id_rsa*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Factory runtime (managed, regenerated each run)
.factory/ai-usage.log
.factory/state.json

# Desktop end-to-end (Playwright) artifacts
apps/desktop/test-results/
apps/desktop/playwright-report/

# Local agent worktrees / Claude Code session state
.claude/
