# Environment variables the factory reads. Copy to .env and fill in what you need;
# never commit .env. Every value here is optional unless noted.

# --- You set these ---------------------------------------------------------------

# Anthropic API key for `factory ai`; fallback when the Claude Code CLI isn't used.
ANTHROPIC_API_KEY=
# GitHub token for API checks, fixes and PRs (else the `gh` CLI's login is used).
GITHUB_TOKEN=
# Alternative name for GITHUB_TOKEN, as the `gh` CLI uses it.
GH_TOKEN=
# Desktop app: OAuth client ID for GitHub device-flow sign-in (dev builds read it from apps/desktop/.env).
FACTORY_GITHUB_CLIENT_ID=
# Desktop app: owner/repo whose Releases the update check queries (default arynbht/software-factory).
FACTORY_UPDATE_REPO=
# Disable coloured CLI output when set.
NO_COLOR=

# --- Set by GitHub Actions or the factory's own action (listed for completeness) ----

# Phase gate `factory ci` evaluates (the action's `gate` input; default build).
FACTORY_GATE=
# owner/repo of the workflow run.
GITHUB_REPOSITORY=
# Checkout directory of the workflow run.
GITHUB_WORKSPACE=
# Path to the triggering event's JSON payload (finds the PR number).
GITHUB_EVENT_PATH=
# File the job summary is appended to.
GITHUB_STEP_SUMMARY=

# --- Set by tooling; don't set by hand -------------------------------------------

# Set by CI providers; Playwright uses it for retries and reporters.
CI=
# Set by electron-vite in dev to the renderer's dev-server URL.
ELECTRON_RENDERER_URL=
# Set by the desktop e2e tests to enable test seams (1 = on).
FACTORY_E2E=
