# electron-builder cannot follow pnpm's default isolated/symlinked node_modules
# when collecting an app's production dependencies, so the engine, the catalog,
# and their transitive runtime deps (@anthropic-ai/sdk, @octokit/rest, eta,
# jsonc-parser, simple-git, tinyglobby, yaml, zod, ...) end up missing from the
# packaged app.asar. A hoisted (flat) node_modules in this app sidesteps that:
# electron-builder sees a normal, resolvable tree and packs the deps it finds in
# package.json. This only affects apps/desktop; the rest of the monorepo keeps
# pnpm's default isolated linker.
node-linker=hoisted
