name: CI

on:
  pull_request:
  push:
    branches: [<%= it.defaultBranch %>]

permissions:
  contents: read

concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

# Setup steps are guarded so this workflow passes before the project has a
# package.json or a lockfile. The checks run the repo's own scripts, and only
# the ones it has: a step that skips a missing script would pass with no
# script at all. Add a lint or test script later and `factory fix` adds its
# step; add a typecheck step by hand.
jobs:
  ci:
    name: ci
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4.4.0
<% if (it.packageManager === "pnpm") { %>
      - name: Set up pnpm
        if: hashFiles('package.json') != ''
        uses: pnpm/action-setup@b906affcce14559ad1aafd4ab0e942779e9f58b1 # v4.3.0
<% } %>
      - name: Set up Node
        uses: actions/setup-node@49933ea5288caeca8642d1e84afbd3f7d6820020 # v4.4.0
        with:
          node-version: "22"
      - name: Cache dependencies
        if: hashFiles('package-lock.json', 'pnpm-lock.yaml', 'yarn.lock') != ''
        uses: actions/cache@5a3ec84eff668545956fd18022155c47e93e2684 # v4.2.3
        with:
<% if (it.packageManager === "pnpm") { %>
          path: ~/.local/share/pnpm/store
<% } else if (it.packageManager === "yarn") { %>
          path: ~/.cache/yarn
<% } else { %>
          path: ~/.npm
<% } %>
          key: ${{ runner.os }}-node-${{ hashFiles('package-lock.json', 'pnpm-lock.yaml', 'yarn.lock') }}
          restore-keys: ${{ runner.os }}-node-
      - name: Install dependencies
        if: hashFiles('package.json') != ''
<% if (it.packageManager === "pnpm") { %>
        run: if [ -f pnpm-lock.yaml ]; then pnpm install --frozen-lockfile; else pnpm install; fi
<% } else if (it.packageManager === "yarn") { %>
        run: if [ -f yarn.lock ]; then yarn install --frozen-lockfile; else yarn install; fi
<% } else { %>
        run: if [ -f package-lock.json ]; then npm ci; else npm install; fi
<% } %>
<%
  const run = it.packageManager === "yarn" ? "yarn" : `${it.packageManager} run`;
  const checks = [
    ["Lint", ["lint"]],
    ["Typecheck", ["typecheck", "type-check", "tsc"]],
    ["Test", ["test"]],
  ];
  // Built as one string: Eta trims the newline after an output tag.
  const steps = checks
    .map(([label, names]) => [label, names.find((n) => it.scripts.includes(n))])
    .filter(([, script]) => script)
    .map(([label, script]) => `      - name: ${label}\n        run: ${run} ${script}\n`)
    .join("");
%>
<%= steps %>
