{
  "name": "software-factory",
  "version": "0.0.0",
  "private": true,
  "description": "An auditor and scaffolder for GitHub repositories: controls-as-data, headless engine, PR-based fixes.",
  "license": "MIT",
  "author": "Aryan Bhatia",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --build",
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "catalog:validate": "tsx packages/catalog/src/validate.cli.ts",
    "schema:json": "tsx packages/catalog/src/schema.gen.ts",
    "action:build": "pnpm build && node scripts/build-action.mjs",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "lefthook": "^1.10.1",
    "lint-staged": "^15.3.0",
    "msw": "^3.0.3",
    "prettier": "^3.4.2",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lefthook"
    ]
  }
}
